# Service systemd Gunicorn — toghinis.com (/var/www/plateforme-com, port 8001)
# sudo cp gunicorn.service /etc/systemd/system/plateforme-com.service
# sudo systemctl daemon-reload && sudo systemctl enable --now plateforme-com

[Unit]
Description=Toghinis.com Django (Gunicorn)
After=network.target postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/plateforme-com/backend
EnvironmentFile=/var/www/plateforme-com/backend/.env
ExecStart=/var/www/plateforme-com/venv/bin/gunicorn \
    transport_platform.wsgi:application \
    --bind 127.0.0.1:8001 \
    --workers 2 \
    --timeout 120 \
    --access-logfile /var/log/plateforme-com/access.log \
    --error-logfile /var/log/plateforme-com/error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
