# Service systemd Gunicorn — utilisateur ubuntu (propriétaire du code)
# sudo cp gunicorn.service /etc/systemd/system/serviceconnect.service
# sudo systemctl daemon-reload && sudo systemctl enable --now serviceconnect

[Unit]
Description=ServiceConnect Django (Gunicorn)
After=network.target postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/plateforme/backend
EnvironmentFile=/var/www/plateforme/backend/.env
ExecStart=/var/www/plateforme/venv/bin/gunicorn \
    transport_platform.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --timeout 120 \
    --access-logfile /var/log/serviceconnect/access.log \
    --error-logfile /var/log/serviceconnect/error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
