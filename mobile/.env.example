# API hébergée (production — plateforme .net)
EXPO_PUBLIC_API_URL=https://toghinis.net/api

# Build release (EAS preview / production) — active HTTPS strict et durcissement réseau
# EXPO_PUBLIC_APP_ENV=production

# Hôtes API autorisés en production (optionnel, séparés par des virgules)
# EXPO_PUBLIC_API_ALLOWED_HOSTS=toghinis.net,www.toghinis.net

# Développement local (Django sur le PC) :
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api
