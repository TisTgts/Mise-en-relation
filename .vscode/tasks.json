{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mobile: Expo start (safe)",
      "type": "shell",
      "command": "npx expo start --lan --clear",
      "options": {
        "cwd": "${workspaceFolder}/mobile",
        "env": {
          "NODE_OPTIONS": ""
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "expo",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Logs for your project will appear|Waiting on|exp://|› Metro:)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Mobile: Expo start (Web)",
      "type": "shell",
      "command": "npx expo start --web --clear",
      "options": {
        "cwd": "${workspaceFolder}/mobile",
        "env": {
          "NODE_OPTIONS": ""
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "expo-web",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Logs for your project will appear|Waiting on|exp://|Web is waiting|Local:)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Frontend: npm start (safe)",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {
          "BROWSER": "none",
          "NODE_OPTIONS": ""
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "cra",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Compiled successfully|compiled with|webpack compiled|Local:)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
