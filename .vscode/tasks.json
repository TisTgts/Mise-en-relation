{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: démarrer le frontend (CRA)",
      "type": "npm",
      "script": "start",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Compiled successfully!|Compiled with warnings\\.|webpack compiled)"
        }
      },
      "options": {
        "env": {
          "BROWSER": "none"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "django: migrate",
      "type": "shell",
      "command": "python",
      "args": ["manage.py", "migrate", "--noinput"],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {}
      },
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
