{
  // Ctrl+Shift+D → F5
  // Expo est démarré en TÂCHE (sans debugger Node) pour éviter le blocage
  // "Debugger attached / Waiting for the debugger to disconnect"
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Django",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "0.0.0.0:8000", "--noreload"],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "DJANGO_SETTINGS_MODULE": "transport_platform.settings",
        "ALLOWED_HOSTS": "localhost,127.0.0.1,0.0.0.0,*"
      }
    },
    {
      // Lance Metro puis attache Django en debug (compound plus bas)
      "name": "Backend: Django (après Expo)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "0.0.0.0:8000", "--noreload"],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "preLaunchTask": "Mobile: Expo start (safe)",
      "env": {
        "DJANGO_SETTINGS_MODULE": "transport_platform.settings",
        "ALLOWED_HOSTS": "localhost,127.0.0.1,0.0.0.0,*"
      }
    },
    {
      "name": "Mobile: Attach debugger (Hermes)",
      "type": "expo",
      "request": "attach",
      "projectRoot": "${workspaceFolder}/mobile",
      "bundlerHost": "127.0.0.1",
      "bundlerPort": "8081"
    },
    {
      "name": "Frontend web: Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "Frontend: npm start (safe)"
    }
  ],
  "compounds": [
    {
      "name": "Debug: Django + Mobile",
      "configurations": ["Backend: Django (après Expo)"],
      "stopAll": true,
      "presentation": {
        "order": 1,
        "group": "0_main",
        "hidden": false
      }
    },
    {
      "name": "Debug: Django + Frontend",
      "configurations": ["Backend: Django", "Frontend web: Chrome"],
      "stopAll": true,
      "presentation": {
        "order": 2,
        "group": "0_main",
        "hidden": false
      }
    }
  ]
}
