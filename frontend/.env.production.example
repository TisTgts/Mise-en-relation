# Copier vers frontend/.env.production avant npm run build sur le VPS
# Un seul domaine : le front et l'API partagent le même site

REACT_APP_API_URL=https://mondomaine.fr/api

# Pays actif (prioritaire sur frontend/src/pays/data/active.json) — tg | bf
REACT_APP_COUNTRY=tg

# Sans domaine (tests avec IP uniquement) :
# REACT_APP_API_URL=http://51.xxx.xxx.xxx/api
