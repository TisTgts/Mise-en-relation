# Copier vers backend/.env — NE PAS committer backend/.env
# Guide complet : deploy/ovh/GUIDE_OVH.md

# --- Production OVH (VPS) ---
SECRET_KEY=generer-avec-python-secrets-token_urlsafe
DEBUG=False
# Domaine + IP du VPS (séparés par des virgules, sans espaces)
ALLOWED_HOSTS=mondomaine.fr,www.mondomaine.fr,51.xxx.xxx.xxx

# PostgreSQL sur le même VPS
DATABASE_URL=postgres://tis:MOT_DE_PASSE@localhost:5432/plateforme_db

# Même domaine que le site React (https après certbot)
CORS_ALLOWED_ORIGINS=https://mondomaine.fr,https://www.mondomaine.fr
CORS_ALLOW_ALL_ORIGINS=False

JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Optionnel
REDIS_URL=redis://localhost:6379/0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
